# CyberQwen PAI — environment. Copy to `.env` and edit. All have code defaults,
# so unset is fine — the one you MUST get right is CYBERQWEN_MODEL.

# ── Ollama ───────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
# EXACT name from `ollama list` — capitalization/tag matter. Wrong name -> 404 on every turn.
CYBERQWEN_MODEL=Cyberqwen
CYBERQWEN_EMBED_MODEL=nomic-embed-text

# ── Agent loop ───────────────────────────────────────────────────────────
CYBERQWEN_MAX_STEPS=20
CYBERQWEN_CONFIRM=chained          # off | chained | all
CYBERQWEN_OLLAMA_TIMEOUT=1800      # seconds; raised for slow CPU inference
CYBERQWEN_VERBOSE=0

# ── Stores (SQLite; ~ is expanded by the code) ───────────────────────────
CYBERQWEN_RAG_DB=~/.cyberqwen/rag.db
CYBERQWEN_THREADS_DB=~/.cyberqwen/threads.db
CYBERQWEN_RAG_CHUNK_WORDS=220
CYBERQWEN_RAG_CHUNK_OVERLAP=40

# ── Aroviq firewall (optional; off by default) ───────────────────────────
CYBERQWEN_AROVIQ=0
CYBERQWEN_AROVIQ_JUDGE=            # e.g. ollama/llama3.2 — adds an LLM call per tool step
CYBERQWEN_AROVIQ_THRESHOLD=0.7
